#include <stdio.h>

long fact_loop(int n) {
    long f = 1;
    int i;
    for (i = 1; i <= n; i++) {
        f = f * i;
    }
    return f;
}

long fact_rec(int n) {
    if (n == 0 || n == 1)
        return 1;
    return n * fact_rec(n - 1);
}

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Factorial is not defined for negative numbers");
        return 0;
    }

    printf("Factorial without recursion = %ld\n", fact_loop(n));
    printf("Factorial with recursion    = %ld\n", fact_rec(n));

    return 0;
}
