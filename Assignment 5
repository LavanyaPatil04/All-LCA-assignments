#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], temp[100];
    int choice, i, j, len;

    printf("Enter first string: ");
    scanf("%s", str1);
    printf("Enter second string: ");
    scanf("%s", str2);

    printf("\n----- MENU -----\n");
    printf("1. Length\n");
    printf("2. Copy\n");
    printf("3. Concatenate\n");
    printf("4. Compare\n");
    printf("5. Reverse\n");
    printf("6. Check Palindrome\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            printf("Length of first string = %d", strlen(str1));
            break;

        case 2:
            strcpy(temp, str1);
            printf("Copied string = %s", temp);
            break;

        case 3:
            strcat(str1, str2);
            printf("Concatenated string = %s", str1);
            break;

        case 4:
            if (strcmp(str1, str2) == 0)
                printf("Strings are equal");
            else
                printf("Strings are not equal");
            break;

        case 5:
            len = strlen(str1);
            for (i = 0, j = len - 1; j >= 0; i++, j--) {
                temp[i] = str1[j];
            }
            temp[i] = '\0';
            printf("Reversed string = %s", temp);
            break;

        case 6:
            len = strlen(str1);
            for (i = 0, j = len - 1; j >= 0; i++, j--) {
                temp[i] = str1[j];
            }
            temp[i] = '\0';
            if (strcmp(str1, temp) == 0)
                printf("Palindrome");
            else
                printf("Not a palindrome");
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
